# ============================================================
# 应用配置
# ============================================================

# 管理后台页面路径前缀（默认 admin；改成如 console-x9 可隐藏后台入口，页面路径仅此生效）
ADMIN_PATH_PREFIX=admin

# [必填] JWT 密钥（兼作通道凭证 Fernet 加密根密钥），uv run python artisan.py key generate
APP_SECRET_KEY=""

# local=本地开发（登录验证码接受万能码 0000）；生产必须 prod（缺省即为 prod）
APP_ENV=prod
APP_DEBUG=false

# 跨域（逗号分隔，* 表示全部）
APP_CORS_ORIGINS=*

# 授权码（作者离线签发的 Ed25519 签名授权码，一行字符串）
# 仅编译镜像（.so 部署）启动时强制校验；本地源码运行不校验。
# 留空或无效 → 容器启动失败（docker logs 可见具体原因）。获取方式：向作者索取
AUTH_CODE=

# ============================================================
# 数据库（MySQL，asyncmy 异步驱动）
# ============================================================

DB_SCHEME=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pay
DB_USERNAME=root
DB_PASSWORD=
# 连接池（单进程有效连接 = POOL_SIZE + MAX_OVERFLOW，按机器规格与 WEB_CONCURRENCY 调整）
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=50
DB_POOL_RECYCLE=1800

# ============================================================
# Web（uvicorn 进程数；有效并发 = WEB_WORKERS × 容器副本数 --scale，
# 调大 worker 数按需同步调大 DB_POOL_SIZE / DB_MAX_OVERFLOW）
# ============================================================

WEB_WORKERS=2

# ============================================================
# Docker 部署（docker-compose.production.yml 插值）
# ============================================================

# app 实例宿主端口范围，仅绑 127.0.0.1，由主机 nginx 反代；范围大小须 ≥ 实例数
APP_PORT_RANGE=8000-8002

# app 实例数（须 ≤ APP_PORT_RANGE 范围大小；运行时可用 --scale app=N 临时覆盖）
APP_REPLICAS=3

# ============================================================
# Redis（队列 / 限流 / 缓存 / 分布式锁）
# ============================================================

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================
# Worker（SAQ：通知阶梯重试 / 掉单补单 / 过期关单）
# ============================================================

WORKER_CONCURRENCY=10
WORKER_JOB_TIMEOUT=300

# ============================================================
# 上游 HTTP 调用超时（秒）
# ============================================================

HTTP_CONNECT_TIMEOUT=5
HTTP_READ_TIMEOUT=15

# ============================================================
# 管理员
# ============================================================

# 初始化超管密码（仅首次 db init 生效，默认 123456）
ADMIN_PASSWORD=123456

# ============================================================
# 本地文件存储
# ============================================================

STORAGE_LOCAL_SECRET=""
STORAGE_LOCAL_HOST=/storage
