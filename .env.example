# 首次使用：cp .env.example .env → uv run artisan.py key generate → uv run artisan.py db init

# ============================================================
# 应用（最常用）
# ============================================================

# 密钥（兼作通道凭证加密根密钥），必须显式填写，留空无法启动
# 生成：uv run python artisan.py key generate
APP_SECRET_KEY=""

# 运行环境：local / dev / prod（缺省 prod；local 下登录验证码接受万能码 0000）
APP_ENV=prod
APP_DEBUG=false

# 授权码（作者离线签发的 Ed25519 签名串）：仅编译镜像启动时校验，填错或留空会以未授权模式运行
AUTH_CODE=

# 管理后台路径前缀，改掉可隐藏入口（管理接口固定 /admin-api，不受影响）
ADMIN_PATH_PREFIX=admin

# 允许跨域的来源，多个用逗号分隔，* 表示全部
APP_CORS_ORIGINS=*

# 多端登录：false = 新登录顶掉其它设备，true = 允许多端同时在线
LOGIN_MULTI_SESSION=false

# 收银台链接有效期（分钟），0 = 不限制
CASHIER_LINK_TTL_MINUTES=1440

# ============================================================
# 数据库（必配，MySQL / asyncmy 异步驱动）
# ============================================================

DB_SCHEME=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pay
DB_USERNAME=root
DB_PASSWORD=
# 连接池（单进程有效连接 = POOL_SIZE + MAX_OVERFLOW，按机器规格调整）
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=50
DB_POOL_RECYCLE=1800

# ============================================================
# Redis（队列 / 限流 / 缓存 / 分布式锁）
# ============================================================

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================
# Web 进程（有效并发 = WEB_WORKERS × 容器副本数）
# ============================================================

# 调大 worker 数时同步调大 DB_POOL_SIZE / DB_MAX_OVERFLOW
WEB_WORKERS=2

# ============================================================
# 容器部署（docker-compose.production.yml 插值）
# ============================================================

# 生产镜像，服务器请固定版本标签，避免 latest 漂移
PAY_IMAGE=ghcr.io/i94m/payment:latest
# app 实例宿主端口范围，仅绑 127.0.0.1 由 nginx 反代，范围大小须 ≥ 实例数
APP_PORT_RANGE=8000-8002
# app 实例数，须 ≤ 端口范围大小
APP_REPLICAS=3

# ============================================================
# Worker（SAQ：通知重试 / 掉单补单 / 过期关单）
# ============================================================

WORKER_CONCURRENCY=10
WORKER_JOB_TIMEOUT=300

# ============================================================
# 上游 HTTP 调用超时（秒）
# ============================================================

HTTP_CONNECT_TIMEOUT=5
HTTP_READ_TIMEOUT=15

# ============================================================
# 本地文件存储
# ============================================================

# 留空默认取 APP_SECRET_KEY；需独立密钥时用 openssl rand -hex 32 生成
STORAGE_LOCAL_SECRET=""
STORAGE_LOCAL_HOST=/storage

# ============================================================
# 后台账号
# ============================================================

# 初始化超管固定为 superadmin / 123456（首次 db init 创建），不通过环境变量配置
