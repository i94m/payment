# ============================================================
# 应用配置
# ============================================================

APP_NAME="聚合支付"
APP_URL=http://localhost:8000

# [必填] JWT 密钥（兼作通道凭证 Fernet 加密根密钥），uv run python artisan.py key generate
APP_SECRET_KEY=""

APP_ENV=local
APP_DEBUG=true

# 跨域（逗号分隔，* 表示全部）
APP_CORS_ORIGINS=*

# ============================================================
# 数据库（MySQL，asyncmy 异步驱动）
# ============================================================

DB_SCHEME=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=epay
DB_USERNAME=root
DB_PASSWORD=
# 连接池（单进程有效连接 = POOL_SIZE + MAX_OVERFLOW，按机器规格与 WEB_CONCURRENCY 调整）
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=50
DB_POOL_RECYCLE=1800

# ============================================================
# Redis（队列 / 限流 / 缓存 / 分布式锁）
# ============================================================

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================
# Worker（SAQ：通知阶梯重试 / 掉单补单 / 过期关单）
# ============================================================

WORKER_CONCURRENCY=10
WORKER_JOB_TIMEOUT=300

# ============================================================
# 上游 HTTP 调用超时（秒）
# ============================================================

HTTP_CONNECT_TIMEOUT=5
HTTP_READ_TIMEOUT=15

# ============================================================
# 管理员
# ============================================================

# 初始化超管密码（仅首次 db init 生效，默认 123456）
ADMIN_PASSWORD=123456

# ============================================================
# 本地文件存储
# ============================================================

STORAGE_LOCAL_SECRET=""
STORAGE_LOCAL_HOST=/storage
