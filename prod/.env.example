# prod 部署配置模板：复制为 prod/.env 后填写（.env 不入库，含真实密钥）
#   cp prod/.env.example prod/.env

# 管理后台页面路径
ADMIN_PATH_PREFIX=admin
# app 端口（改后需同步 nginx upstream）
APP_PORT=8000
# uvicorn 进程数（host 模式单容器，扩并发调这里；调大按需同步 DB_POOL_SIZE）
WEB_WORKERS=4
# ============================================================
# 数据库配置（宿主机 MySQL）
# ============================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pay
DB_USERNAME=pay
DB_PASSWORD=
# ============================================================
# Redis配置（宿主机）
# ============================================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# 应用密钥（不会自动生成，缺配启动直接报错；openssl rand -hex 32 或 artisan.py key generate 生成，不要复用其他环境）
APP_SECRET_KEY=""
# 本地存储密钥（可选：留空默认取 APP_SECRET_KEY；需独立密钥则 openssl rand -hex 32 生成）
STORAGE_LOCAL_SECRET=""
# 授权码（作者离线签发，scripts/license_gen.py issue；留空或无效时编译镜像启动即退出）
AUTH_CODE=
# 授权公钥覆盖（可选，44 字符 base64 纯字符串）：不填用镜像内置；填了优先，换钥免重建镜像
LICENSE_PUBLIC_KEY=
